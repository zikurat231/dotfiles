{
  "title": "Мой полный конфиг (Caps + Lang + AltTab + Kitty)",
  "rules": [
    {
      "description": "1. Caps Lock: Esc / Удержание: D=Backspace, HJKL=Стрелки, A=Ctrl+G (испр. A на G)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "delete_or_backspace" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "g", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "g", "modifiers": ["left_control"] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "j", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "down_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "k", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "up_arrow" }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "variable_if", "name": "caps_layer", "value": 1 }],
          "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "right_arrow" }]
        },
        {
          "type": "basic",
          "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
          "to": [{ "set_variable": { "name": "caps_layer", "value": 1 } }],
          "to_after_key_up": [{ "set_variable": { "name": "caps_layer", "value": 0 } }],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    },
    {
      "description": "2. Смена языка: Shift + Физический Command (кнопка у пробела)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_shift",
            "modifiers": { "mandatory": ["left_control"], "optional": ["caps_lock"] }
          },
          "to_if_alone": [{
            "key_code": "spacebar",
            "modifiers": ["left_control", "left_option", "left_command"]
          }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 500 }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": { "mandatory": ["left_shift"], "optional": ["caps_lock"] }
          },
          "to_if_alone": [{
            "key_code": "spacebar",
            "modifiers": ["left_control", "left_option", "left_command"]
          }],
          "parameters": { "basic.to_if_alone_timeout_milliseconds": 500 }
        }
      ]
    },
    {
      "description": "3. Alt-Tab Advanced: Full Navigation (Tab, Shift+Tab, Arrows)",
      "manipulators": [
        {
          "type": "basic",
          "from": { 
            "key_code": "tab", 
            "modifiers": { "mandatory": ["left_control", "left_shift"] } 
          },
          "to": [{ "key_code": "tab", "modifiers": ["left_command", "left_shift"] }]
        },
        {
          "type": "basic",
          "from": { 
            "key_code": "tab", 
            "modifiers": { "mandatory": ["left_control"] } 
          },
          "to": [{ "key_code": "tab", "modifiers": ["left_command"] }]
        },
        {
          "type": "basic",
          "from": { 
            "key_code": "left_arrow", 
            "modifiers": { "mandatory": ["left_control"] } 
          },
          "to": [{ "key_code": "left_arrow", "modifiers": ["left_command"] }]
        },
        {
          "type": "basic",
          "from": { 
            "key_code": "right_arrow", 
            "modifiers": { "mandatory": ["left_control"] } 
          },
          "to": [{ "key_code": "right_arrow", "modifiers": ["left_command"] }]
        }
      ]
    },
    {
      "description": "4. В Kitty: физический Fn работает как Control для Neovim",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["^net\\.kovidgoyal\\.kitty$"]
            }
          ],
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            { "key_code": "left_control" }
          ]
        }
      ]
    }
  ]
}
