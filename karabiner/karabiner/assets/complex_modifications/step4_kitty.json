{
  "title": "Шаг 4: Исключение для Kitty (Fn = Control)",
  "rules": [
    {
      "description": "В Kitty: физический Fn работает как Control для Neovim",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^net\\.kovidgoyal\\.kitty$"
              ]
            }
          ],
          "from": { 
            "key_code": "left_command", 
            "modifiers": { "optional": ["any"] } 
          },
          "to": [ 
            { "key_code": "left_control" } 
          ]
        }
      ]
    }
  ]
}
